{
  "manifest_version": 3,
  "name": "Cart Reset by HyperWumpus",
  "version": "0.5.0",
  "description": "Group and review Walmart and Costco Same-Day carts; download visual reminders and remove selected items in batches.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Cart Reset by HyperWumpus",
    "default_icon": {
      "16": "icons/cart-icon-16.png",
      "32": "icons/cart-icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/cart-icon-16.png",
    "32": "icons/cart-icon-32.png",
    "48": "icons/cart-icon-48.png",
    "128": "icons/cart-icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/wumpi-cart.png",
        "assets/cart-reset-background.jpeg"
      ],
      "matches": [
        "https://www.walmart.com/*",
        "https://sameday.costco.com/*"
      ]
    }
  ]
}
